# Core Terraform directories
.terraform/

# Local state files and backups
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Lock file (optional)
.terraform.lock.hcl

# Exclude all variable files (may contain sensitive secrets)
*.tfvars
*.tfvars.json

# Exclude local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you strictly intend to build/test with
# !override.tf

# CLI configuration file
.terraformrc
terraform.rc
